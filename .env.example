# Copy this file to .env and fill in your values.
# Get these from Roobet: affiliate dashboard → API / Roobet Connect.

ROOBET_API_KEY=your_roobet_api_token_here
ROOBET_USER_ID=your_roobet_user_id_here

# Rank by RTP-weighted wager (standard for Roobet leaderboards). Set false for raw wager.
USE_WEIGHTED_WAGER=true

# How often to refresh from Roobet (minutes)
CACHE_MINUTES=5

PORT=3000
