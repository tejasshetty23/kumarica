# Copy this file to .env and fill in your values.
# Get these from Roobet: affiliate dashboard → API / Roobet Connect.

ROOBET_API_KEY=your_roobet_api_token_here
# Optional: leave blank and the user ID is read from the API key
ROOBET_USER_ID=

# How often to refresh from Roobet (minutes)
CACHE_MINUTES=5

PORT=3000
